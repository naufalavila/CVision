# ==============================================
# CVision .gitignore optimized for GitHub & Streamlit Cloud Deployment
# ==============================================

# ------------------------------
# Python & Environment
# ------------------------------
__pycache__/
*.py[oc]
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
wheels/
*.egg
.Python

# Virtual environments
venv/
env/
.venv/
.env/
.venv
.env
.python-version

# Environment secrets - NEVER commit this!
.env.local
.env.production
.env.*
secrets.json
credentials.json
*.key

# ------------------------------
# Streamlit Specific
# ------------------------------
.streamlit/secrets.toml
.streamlit/config.toml
.streamlit/cache/
session_storage/
*.streamlit
.streamlit/*
!.streamlit/README.md

# ------------------------------
# Generated files & Uploads
# ------------------------------
*.pdf
*.docx
*.doc
*.txt
uploads/
temp/
tmp/
*.tmp
*.temp
exported_reports/
downloads/

# ------------------------------
# Logs & Debug
# ------------------------------
*.log
logs/
debug.log
error.log
streamlit_runtime_logs/
*.trace

# ------------------------------
# OS Generated
# ------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ------------------------------
# IDE & Editors
# ------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.iml
*.ipr
*.iws
.atom/
.notebook

# ------------------------------
# Git & Repository
# ------------------------------
.gitattributes
*.diff
*.patch

# ------------------------------
# ALLOWED Files (DO NOT IGNORE THESE)
# ------------------------------
# !main.py
# !requirements.txt
# !README.md
# !.gitignore
# !.env.example
